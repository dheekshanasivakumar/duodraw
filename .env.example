# Supabase project credentials (public/anon key only — NEVER put the service_role key here)
# Find both in your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Minutes of inactivity before an idle room auto-expires
VITE_ROOM_EXPIRY_MINUTES=30
